-- Одноразовый скрипт: SQL Developer (F5), SQLcl или SQL*Plus.
-- Замените имена ниже. Все четыре создаваемые таблицы должны быть новыми.
-- Входная таблица: CLIENT_DID, REPORT_DATE (DATE).
define in_table = MY_SCORING_INPUT
define out_table = MY_SCORING_DEP_2F
define contracts_table = TMP_DEP2_CONTRACTS
define monthly_table = TMP_DEP2_MONTHLY
define features_table = TMP_DEP2_FEATURES

-- Сохраняет все строки входа; при отсутствии истории фичи NULL.
-- Исходная процедура исключала ключи без месячной истории за 24 месяца.
-- Сохранены исходные условия договоров и семантика RN / соединений ODS.

-- 1. Договоры
create table &contracts_table parallel 4 as
select /*+ parallel(4) */
           a.client_did,
           a.report_date,
           b.contract_src_id,
           b.contract_uid,
           b.product_category_nm,
           row_number() over (
               partition by a.client_did, a.report_date, b.contract_uid
               order by b.open_dt asc
           ) rn
    from &in_table a
    join dm_mrk.DM_MRK_CONTRACT b
      on b.client_did = a.client_did
     and b.contract_type = 'D'
     and b.open_dt < a.report_date
     and coalesce(b.fact_close_dt, date '9999-12-31')
             >= add_months(a.report_date, -24)
     and a.report_date between b.effective_from_dt and b.effective_to_dt
     and b.product_category_nm in (
         'Договор на текущий счет для дебетовой карты',
         'Срочный депозит',
         'Депозит до востребования',
         'Договор на текущий счет'
     );

alter table &contracts_table noparallel;

-- 2. Суммы за 6 месяцев по строкам договоров
create table &monthly_table parallel 4 as
-- Сначала сворачиваем месяцы до одной строки на строку договора.
    -- RN в GROUP BY сохраняет кратность строк исходной процедуры.
    select /*+ parallel(4) */
           c.client_did,
           c.report_date,
           c.contract_src_id,
           c.contract_uid,
           c.product_category_nm,
           c.rn,
           sum(case
               when m.report_month >= add_months(trunc(c.report_date, 'mm'), -1)
               then m.current_balance_sum
           end) balance_1m,
           sum(m.purchase_count) purchase_count_6m
    from &contracts_table c
    join dm_mrk.DM_MRK_CONTRACT_AGG_MONTHLY m
      on m.contract_uid = c.contract_uid
     and m.report_month < trunc(c.report_date, 'mm')
     and m.report_month >= add_months(trunc(c.report_date, 'mm'), -6)
    group by c.client_did, c.report_date, c.contract_src_id,
             c.contract_uid, c.product_category_nm, c.rn;

alter table &monthly_table noparallel;

-- 3. Две фичи по клиенту и дате
create table &features_table parallel 4 as
select /*+ parallel(4) */
           c.client_did,
           c.report_date,
           sum(case
               when c.product_category_nm = 'Договор на текущий счет для дебетовой карты'
                and v.c_name not like '%акоп%'
               then c.balance_1m
           end) contract_agg_monthly_dep_card_eom_balance_aggsum_1m,
           sum(c.purchase_count_6m)
               contract_agg_monthly_dep_total_purchase_count_aggsum_6m
    from &monthly_table c
    left join ods.ods_rtl_DEPN d
      on c.contract_src_id = d.id
     and c.rn = 1
     and d.dml_type_cd <> 'D'
    left join ods.ods_rtl_VID_DEPOSIT v
      on d.c_vid_dog = v.id
     and v.dml_type_cd <> 'D'
    group by c.client_did, c.report_date;

alter table &features_table noparallel;

-- 4. Итог с сохранением всех строк входа
create table &out_table parallel 4 as
select /*+ parallel(4) */
       a.client_did,
       a.report_date,
       f.contract_agg_monthly_dep_card_eom_balance_aggsum_1m,
       f.contract_agg_monthly_dep_total_purchase_count_aggsum_6m
from &in_table a
left join &features_table f
  on f.client_did = a.client_did
 and f.report_date = a.report_date;

alter table &out_table noparallel;

-- При необходимости удалить промежуточные таблицы после проверки результата:
-- drop table &features_table;
-- drop table &monthly_table;
-- drop table &contracts_table;

undefine in_table
undefine out_table
undefine contracts_table
undefine monthly_table
undefine features_table

