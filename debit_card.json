max(case when product_category_new = ''Депозит до востребования'' and report_month >= add_months(trunc(report_date, ''mm''), -24) then CURRENT_BALANCE_SUM else null end) contract_agg_monthly_dep_demand_eom_balance_aggmax_24m,
