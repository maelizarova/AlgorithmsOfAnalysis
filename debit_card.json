create or replace procedure MN_COLLECT_FEAT_DM_MRK_CONTRACT_AGG_MONTHLY_DEP
(in_table in VARCHAR2,
 out_table in VARCHAR2) 
AUTHID CURRENT_USER 
IS
sttm0 varchar2(32767 char);
sttm1 varchar2(32767 char);
sttm2 varchar2(32767 char);
sttm3 varchar2(32767 char);
sttm4 varchar2(32767 char);
sttm5 varchar2(32767 char);
sttm6 varchar2(32767 char);
sttm7 varchar2(32767 char);
sttm8 varchar2(32767 char);
sttm9 varchar2(32767 char);
sttm10 varchar2(32767 char);
sttm11 varchar2(32767 char);
sttm12 varchar2(32767 char);


   -- Универсальная процедура для удаления таблицы, игнорируя ошибку, если таблица не существует
  PROCEDURE drop_table_if_exists(table_name IN VARCHAR2) IS
  BEGIN
    EXECUTE IMMEDIATE 'DROP TABLE ' || table_name;
  EXCEPTION
    WHEN OTHERS THEN
      IF SQLCODE = -942 THEN
        NULL;  -- Игнорируем ошибку "таблица не существует"
      ELSE
        RAISE;  -- Для других ошибок выбрасываем исключение
      END IF;
  END drop_table_if_exists;
 
BEGIN

drop_table_if_exists(upper(concat(in_table, '_contract_agg_monthly_dep_contract_table')));
drop_table_if_exists(upper(concat(in_table, '_contract_agg_monthly_dep_depname_table')));
drop_table_if_exists(upper(concat(in_table, '_contract_agg_monthly_dep_month_agg_table')));
drop_table_if_exists(upper(concat(in_table, '_contract_agg_monthly_dep_feat_table1')));
drop_table_if_exists(upper(concat(in_table, '_contract_agg_monthly_dep_feat_table2')));
drop_table_if_exists(upper(concat(in_table, '_contract_agg_monthly_dep_feat_table3')));
drop_table_if_exists(upper(concat(in_table, '_contract_agg_monthly_dep_feat_table4')));
drop_table_if_exists(upper(concat(in_table, '_contract_agg_monthly_dep_eom_balance_table')));
drop_table_if_exists(upper(concat(in_table, '_contract_agg_monthly_dep_feat_table5')));
drop_table_if_exists(''||out_table||'');

-- КОНТРАКТЫ
execute immediate
'
create table '||in_table||'_contract_agg_monthly_dep_contract_table as
select   /*+ PARALLEL(8) */
a.client_did,
a.report_date, 
b.CONTRACT_SRC_ID,
b.contract_uid,
b.OPEN_DT,
b.fact_close_dt, 
b.product_category_nm, 
b.status_nm,
ROW_NUMBER() OVER ( PARTITION BY a.client_did, a.report_date, b.contract_uid ORDER BY b.open_dt asc ) rn
from  '||in_table||' a
inner join dm_mrk.DM_MRK_CONTRACT b
      on a.client_did = b.client_did
      and b.contract_type = ''D''
      and b.open_dt < a.report_date
      and coalesce(b.fact_close_dt, date ''9999-12-31'') >= add_months(a.report_date, -24)
      and a.report_date between effective_from_dt and effective_to_dt
      and b.product_category_nm in  ( 
                                     ''Договор на текущий счет для дебетовой карты'',
                                     ''Срочный депозит'',
                                     ''Депозит до востребования'', 
                                     ''Договор на текущий счет'')';
                                     
-- НАЗВАНИЯ ДЕПОЗИТОВ                                     
execute immediate
' 
create table '||in_table||'_contract_agg_monthly_dep_depname_table as
select   /*+ PARALLEL(8) */
a.*,
vid_depn.C_NAME as dep_name
  
from '||in_table||'_contract_agg_monthly_dep_contract_table a
left join ods.ods_rtl_DEPN depn
     on a.CONTRACT_SRC_ID = depn.id 
     and a.rn = 1
     and depn.dml_type_cd <> ''D''
left join ods.ods_rtl_VID_DEPOSIT vid_depn
     on depn.C_VID_DOG = vid_depn.id 
     and vid_depn.dml_type_cd <> ''D'' ';  
     
     
-- МЕСЯЧНЫЕ АГРЕГАТЫ
execute immediate
' 
create table '||in_table||'_contract_agg_monthly_dep_month_agg_table as
select /*+ PARALLEL(8) */ 
a.client_did,
a.report_date,
a.contract_uid,
a.product_category_nm,
a.dep_name,
case 
  when product_category_nm = ''Договор на текущий счет для дебетовой карты'' and dep_name  LIKE ''%акоп%'' then ''Накопительный счет''
  when product_category_nm = ''Договор на текущий счет для дебетовой карты'' and dep_name NOT LIKE ''%акоп%'' then ''Карточный счет''
    else product_category_nm
      end product_category_new,
a.status_nm,
b.REPORT_MONTH, 
CURRENT_BALANCE_AVG_SUM, 
CURRENT_BALANCE_SUM, 
CURRENT_CREDIT_TURN_SUM, 
CURRENT_DEBIT_TURN_SUM, 
CURRENT_DEBIT_CLIENT_TURN_SUM, 
CASH_IN_OFC_SUM, 
CASH_IN_OFC_COUNT, 
CASH_OUT_OFC_SUM, 
CASH_OUT_OFC_COUNT, 
CASH_IN_ATM_SUM, 
CASH_IN_ATM_COUNT, 
CASH_OUT_ATM_SUM, 
CASH_OUT_ATM_COUNT, 
PURCHASE_SUM, 
PURCHASE_COUNT, 
INTEREST_OUTCOME_SUM, 
CURRENT_INTEREST_RATE

from '||in_table||'_contract_agg_monthly_dep_depname_table a
inner join dm_mrk.DM_MRK_CONTRACT_AGG_MONTHLY b
  on  a.contract_uid = b.contract_uid
  and b.report_month < trunc(a.report_date, ''mm'')
  and b.report_month >= add_months(trunc(a.report_date, ''mm''), -24)';

-- ФИЧИ БАЛАНСЫ
sttm0 := 'create table '||in_table||'_contract_agg_monthly_dep_feat_table1 as 
select /*+ PARALLEL(8) */  
client_did,
report_date,

sum(case when report_month >= add_months(trunc(report_date, ''mm''), -1) then CURRENT_BALANCE_SUM else null end) contract_agg_monthly_dep_total_eom_balance_aggsum_1m,
sum(case when product_category_new = ''Депозит до востребования'' and report_month >= add_months(trunc(report_date, ''mm''), -1) then CURRENT_BALANCE_SUM else null end) contract_agg_monthly_dep_demand_eom_balance_aggsum_1m,
sum(case when product_category_new = ''Карточный счет'' and report_month >= add_months(trunc(report_date, ''mm''), -1) then CURRENT_BALANCE_SUM else null end) contract_agg_monthly_dep_card_eom_balance_aggsum_1m,
sum(case when product_category_new = ''Договор на текущий счет'' and report_month >= add_months(trunc(report_date, ''mm''), -1) then CURRENT_BALANCE_SUM else null end) contract_agg_monthly_dep_current_eom_balance_aggsum_1m,
sum(case when product_category_new = ''Срочный депозит'' and report_month >= add_months(trunc(report_date, ''mm''), -1) then CURRENT_BALANCE_SUM else null end) contract_agg_monthly_dep_term_eom_balance_aggsum_1m,
