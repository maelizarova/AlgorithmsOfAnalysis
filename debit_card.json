WITH params AS (
    SELECT
        TRUNC(SYSDATE - 1)                     AS report_date,          -- 20е число
        TRUNC(ADD_MONTHS(TRUNC(SYSDATE - 1), -1)) AS start_txn_date,    -- 20е число предыдущего месяца
        ADD_MONTHS(TRUNC(SYSDATE - 1), -3)      AS issue_limit_date     -- 3 месяца назад
    FROM dual
),

prib_clients AS (
    SELECT DISTINCT
        b.client_did
    FROM params p
    JOIN dm.cards@db_space a               ON 1 = 1
    JOIN cmdm2.card@db_space b             ON a.card_uid = b.card_uid
    JOIN dm.contracts@db_space c
          ON c.acc_src_id = b.acc_src_id
         AND c.product_category_nm = 'Договор на текущий счет для дебетовой карты'
    WHERE ( LOWER(a.scheme_nm) LIKE '%prib%'
            OR a.scheme_nm IN (
                 '147-OUR PRIV NSPK MIR CARDS DUAL FK KRASNODAR IVR RUR',
                 '147-OUR PRIV NSPK MIR CARDS DUAL FK KRASNODAR RUR'
               )
          )
      AND a.bank_card_type = 'DC'
      AND a.SUB_PRODUCT <> 'Корп/Бизнес'
      AND p.report_date BETWEEN a.ISSUE_DT AND NVL(a.CARD_CLOSE_DT, DATE '3000-01-01')
      AND a.ISSUE_DT <= p.issue_limit_date
),

all_transactions AS (
    /* POS‑транзакции */
    SELECT txn.client_did
    FROM params p
    JOIN prib_clients pc          ON 1 = 1
    JOIN DM_MRK.DM_MRK_TRANSACTION txn
          ON txn.client_did = pc.client_did
    WHERE txn.transaction_dtm >= p.start_txn_date
      AND txn.transaction_dtm <  p.report_date
      AND txn.direction = 'D'
      AND txn.AMOUNT_RUR > 0
      AND txn.POSTING_FLG = 1
      AND txn.mcc_code NOT IN ('6010','6011')          -- исключаем снятие наличных

    UNION

    /* QR‑транзакции */
    SELECT c.client_did
    FROM params p
    JOIN prib_clients pc          ON 1 = 1
    JOIN dm.qr_dbo4_operation@db_space qr
          ON qr.operation_dt >= p.start_txn_date
         AND qr.operation_dt <  p.report_date
         AND qr.amount > 0
    JOIN dm.cards@db_space c
          ON qr.payer_card_src_id = c.card_src_id
    WHERE c.client_did = pc.client_did

    UNION

    /* DBO‑транзакции */
    SELECT dbo.client_did
    FROM params p
    JOIN prib_clients pc          ON 1 = 1
    JOIN dm.dbo_operation@db_space dbo
          ON dbo.created_tz >= p.start_txn_date
         AND dbo.created_tz <  p.report_date
         AND dbo.OPER_TYPE_NM = 'Финансовая операция'
         AND dbo.OPER_NM = 'Оплата услуг через систему Сити+'
         AND dbo.oper_amt > 0
    WHERE dbo.client_did = pc.client_did
),

sample AS (
    SELECT DISTINCT
           client_did,
           (SELECT report_date FROM params) AS report_date
    FROM   all_transactions
)
